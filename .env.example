# ============================================================
# KroomboxAPI - Environment Configuration
# ============================================================
# Salin file ini menjadi .env dan isi nilainya

# --- SERVER ---
PORT=3000
NODE_ENV=development

# --- JWT SECRETS (Ganti dengan string random yang kuat!) ---
JWT_SECRET=kroombox_super_secret_key_GANTI_INI_123!
REFRESH_SECRET=kroombox_super_refresh_secret_GANTI_INI!
ADMIN_JWT_SECRET=kroombox_admin_super_secret_GANTI_INI!

# --- WEBHOOK SECURITY ---
# Secret untuk mengamankan komunikasi antar server (dari KroomBridge Panel)
WEBHOOK_SECRET=kroombox_internal_secret_GANTI_INI!

# --- GPU MONITORING ---
# Secret yang dipakai PC Putih & PC Hitam untuk mengirim metrik GPU
# ke endpoint POST /api/gpu/report. Jika kosong, akan fallback ke WEBHOOK_SECRET.
GPU_REPORT_SECRET=kroombridge_gpu_report_secret_GANTI_INI!

# --- GPU SSH POLLER (opsional) ---
# Server KroomBridge SSH ke PC remote dan jalankan `nvidia-smi` tiap N detik.
# PC remote tidak perlu install agent — cukup SSH server aktif + driver NVIDIA.
#
# Format: hostId:host:port:user:credential[,hostId:host:port:user:credential...]
#   - hostId   : pc-putih / pc-hitam (akan ditampilkan di dashboard)
#   - host     : IP / hostname PC remote
#   - port     : SSH port (default 22)
#   - user     : SSH username
#   - credential: path private key (mis. C:/Users/me/.ssh/id_rsa)
#                 atau "password=xxx" untuk login pakai password
#
# Contoh pakai SSH key:
#   GPU_SSH_HOSTS=pc-putih:192.168.1.10:22:kroombox:C:/Users/admin/.ssh/id_rsa
#
# Contoh pakai password:
#   GPU_SSH_HOSTS=pc-putih:192.168.1.10:22:kroombox:password=passwordnya123
#
# Multi host (PC Putih + PC Hitam):
#   GPU_SSH_HOSTS=pc-putih:192.168.1.10:22:kroombox:password=passputih,pc-hitam:192.168.1.11:22:kroombox:password=passhitam
GPU_SSH_HOSTS=

# Interval polling SSH dalam ms (default: 5000 = 5 detik)
GPU_SSH_POLL_INTERVAL_MS=5000

# --- GPU LOCAL POLLER (opsional) ---
# Kalau server KroomBridge dijalankan DI PC yang sama dengan GPU NVIDIA-nya
# (mis. PC Putih sekaligus jadi server), aktifkan ini supaya server langsung
# baca nvidia-smi tanpa SSH.
GPU_LOCAL_ENABLED=false
GPU_LOCAL_HOST_ID=pc-putih
GPU_LOCAL_HOST_NAME=PC Putih
GPU_LOCAL_POLL_INTERVAL_MS=3000

# --- QUOTA RESET SCHEDULE ---
# Hari reset kuota bulanan (1-28, default: 1 = tanggal 1 setiap bulan)
QUOTA_RESET_DAY=1

# --- CORS ---
# URL frontend/panel yang diizinkan mengakses API ini
# Pisahkan dengan koma jika lebih dari satu
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- NOTIFIKASI (Opsional) ---
# Jika ingin mengirim email notifikasi kuota, isi konfigurasi SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# --- APP URL ---
APP_URL=http://localhost:3000
GEMINI_API_KEY=MY_GEMINI_API_KEY
