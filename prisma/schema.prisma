generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("Admin")
  lastLogin DateTime?
  createdAt DateTime @default(now())
}

model Package {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  monthlyQuota        Int
  maxRequestsPerMinute Int
  quotaType           String   @default("request") // 'request' or 'token'
  createdAt           DateTime @default(now())
  clients             Client[]
}

model Client {
  id             String   @id @default(uuid())
  name           String
  email          String?
  secretKey      String   @unique
  packageId      String
  package        Package  @relation(fields: [packageId], references: [id])
  usageThisMonth Int      @default(0)
  customQuota    Int?
  isActive       Boolean  @default(true)
  status         String   @default("active") // 'active' or 'suspended'
  tags           String?  // Store as comma separated string or JSON
  notes          String?
  createdAt      DateTime @default(now())
  logs           ApiLog[]
}

model Route {
  id             String   @id @default(uuid())
  path           String   @unique
  upstreamUrl    String
  isActive       Boolean  @default(true)
  requireAuth    Boolean  @default(true)
  rateLimit      Int?
  stripPath      Boolean  @default(true)
  methods        String   @default("GET,POST,PUT,DELETE")
  createdAt      DateTime @default(now())
  logs           ApiLog[]
}

model ApiLog {
  id          String   @id @default(uuid())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  routeId     String?
  route       Route?   @relation(fields: [routeId], references: [id])
  path        String
  method      String
  statusCode  Int
  durationMs  Int
  ipAddress   String
  userAgent   String?
  errorMessage String?
  timestamp   DateTime @default(now())
}

model SecurityConfig {
  id                        Int     @id @default(1)
  ipAllowlist               String  @db.Text // JSON string
  ipDenylist                String  @db.Text // JSON string
  rateLimitAnomalyDetection Boolean @default(true)
  upstreamValidationShield  Boolean @default(true)
}
