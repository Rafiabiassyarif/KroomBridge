{
  "name": "kroombridge-root",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "start": "npm run build && npm run start --workspace=backend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
